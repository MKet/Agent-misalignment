# OpenRouter API key (required)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: override the OpenRouter base URL (for testing)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/model-misalignment

# Web UI server port (default: 3000)
WEB_PORT=3000

# Optional: OpenRouter base URL (leave blank to use default)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: log level (DEBUG | INFO | WARN | ERROR)
LOG_LEVEL=INFO
